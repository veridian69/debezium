# Pinned versions (verified against Docker Hub / quay.io on 2026-10-09)
POSTGRES_IMAGE_TAG=18.6-alpine
DEBEZIUM_IMAGE_TAG=3.7.0.Final
# Build images used by receiver/Dockerfile (passed as build args there)
MAVEN_IMAGE_TAG=3.10.0-eclipse-temurin-25-alpine
JRE_IMAGE_TAG=25.0.4_7-jre-alpine

# Local development credentials. Plain HTTP, no auth. Not for production.
PG_USER=dbz
PG_PASSWORD=dbz
PG_DATABASE=appdb

# Host ports (bound to 127.0.0.1 only)
PG_HOST_PORT=5432
RECEIVER_HOST_PORT=8080
DEBEZIUM_HOST_PORT=8081

# UID/GID used inside receiver and generator containers so bind-mounted
# ./logs and ./runs stay owned by the WSL user.
HOST_UID=1000
HOST_GID=1000
